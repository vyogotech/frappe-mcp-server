# Frappe MCP Server Environment Variables
# Copy this file to .env and fill in your values
# Usage: cp env.example .env

# Frappe Instance Connection (Required)
# Works with ERPNext, Frappe HR, Healthcare, and any Frappe app
FRAPPE_BASE_URL=http://localhost:8000
FRAPPE_API_KEY=your_api_key_here
FRAPPE_API_SECRET=your_api_secret_here

# Server Ports
MCP_PORT=8080
ERPNEXT_PORT=8000

# ERPNext Local Instance (only if using full-stack profile)
ERPNEXT_ADMIN_PASSWORD=admin
ERPNEXT_DEV_MODE=1

# Logging
LOG_LEVEL=info

