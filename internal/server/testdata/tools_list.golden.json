  {
    "description": "Count, sum or average ERPNext records. Use this for any \"how many\" question: with metric=\"count\" it returns the exact total of all matching records, not just one page.",
    "inputSchema": {
      "properties": {
        "doctype": {
          "description": "Document type to aggregate over",
          "type": "string"
        },
        "field": {
          "description": "Field to aggregate (required when metric != count)",
          "type": "string"
        },
        "filters": {
          "description": "Optional field-value filters",
          "type": "object"
        },
        "group_by": {
          "description": "Field to group by (optional)",
          "type": "string"
        },
        "metric": {
          "description": "Aggregation: sum|count|avg|min|max",
          "type": "string"
        },
        "top_n": {
          "description": "Return top N groups only",
          "type": "integer"
        }
      },
      "required": [
        "doctype",
        "metric"
      ],
      "type": "object"
    },
    "name": "aggregate_documents"
  },
